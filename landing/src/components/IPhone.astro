---
// An iPhone (13-15 proportions, 390 x 844 pt) drawn in CSS around a
// screenshot of the app as a home-screen app: status bar with the Dynamic
// Island, then the screenshot (390 x 797). The status bar takes the app's
// top bar color, so it follows light and dark mode like the screenshot.
// With `lock`, the status bar floats in white over a lock screen
// (components/LockScreen.astro) instead.
interface Props { lock?: boolean }
const { lock = false } = Astro.props;
---
<div class:list={['iphone', lock && 'iphone-lock']}>
  <div class="iphone-screen">
    <div class="iphone-status" aria-hidden="true">
      <span class="iphone-time">9:41</span>
      <span class="iphone-island"></span>
      <span class="iphone-icons">
        <svg viewBox="0 0 18 12" width="18" height="12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
        <svg viewBox="0 0 16 12" width="16" height="12"><path d="M8 2.6c2.3 0 4.4.9 6 2.4l1.1-1.2A10.2 10.2 0 0 0 8 1 10.2 10.2 0 0 0 .9 3.8L2 5a8.6 8.6 0 0 1 6-2.4Zm0 3.3c1.4 0 2.6.5 3.6 1.4l1.1-1.2A6.9 6.9 0 0 0 8 4.3a6.9 6.9 0 0 0-4.7 1.8l1.1 1.2c1-.9 2.2-1.4 3.6-1.4Zm0 3.3c-.6 0-1.1.2-1.5.6L8 11.5l1.5-1.7c-.4-.4-.9-.6-1.5-.6Z" /></svg>
        <svg viewBox="0 0 27 12" width="27" height="12"><rect x="0.5" y="0.5" width="23" height="11" rx="3.2" fill="none" stroke="currentColor" stroke-opacity="0.4" /><rect x="2" y="2" width="20" height="8" rx="2" /><path d="M25 4v4a2 2 0 0 0 0-4Z" fill-opacity="0.4" /></svg>
      </span>
    </div>
    <slot />
  </div>
</div>
