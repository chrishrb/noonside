---
// The noonside mark, as LogoMark in web/src/components/ui/Logo.tsx.
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="var(--brand-sun)" />
  <path d="M11.5 24v-5.5a4.5 4.5 0 0 1 9 0v5.5" fill="none" stroke="#ffffff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="16" cy="8" r="2.5" fill="#ffffff" />
</svg>
