# Response headers of every file (add_header in a location replaces the
# server's, so each location includes this).
#
# The session lives in localStorage, so injected scripts must not run
# (script-src 'self'; keep inline scripts out of index.html). connect-src:
# the API and GoTrue share the origin, Sentry goes through the API's tunnel
# (/api/v1/diag); CSP_CONNECT_SRC adds hosts. img-src: the map tiles (TILE_URL
# in web/src/lib/map.ts). worker-src blob: Sentry's replay compression worker.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' ${CSP_CONNECT_SRC}; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
